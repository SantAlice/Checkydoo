# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# Пароль PostgreSQL (придумай надёжный)
DB_PASSWORD=your_strong_password_here

# Секрет для JWT токенов (минимум 32 символа, случайная строка)
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_minimum_32_chars

# Домен или IP, на котором работает приложение
CORS_ORIGIN=https://your-domain.ru

# URL API для фронтенда (обычно /api)
VITE_API_URL=/api
